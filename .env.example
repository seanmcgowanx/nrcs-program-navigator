# Copy this file to .env and fill in real values. Never commit .env.
# Load it in code with python-dotenv (load_dotenv()).

# --- LLM providers ---
# Premier model leg of the comparison (e.g. gpt-4o).
OPENAI_API_KEY=

# Optional: only needed if the cheaper leg is a Gemini model. The factory in
# agent/llms.py supports gemini-* names; the default cheap leg is gpt-4o-mini.
GOOGLE_API_KEY=

# --- Tracing (LangSmith) ---
# Set tracing on so every agent run is captured as a trace.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nrcs-navigator
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Model selection (read by src/nrcs_navigator/config.py) ---
# Named so the evaluation can swap models without touching agent code.
PREMIER_MODEL=gpt-4o
CHEAP_MODEL=gpt-4o-mini
# Model the LLM judge scores with. Kept off gpt-4o so the premier agent leg and
# the judge do not share gpt-4o's per-minute token budget (avoids rate limiting).
JUDGE_MODEL=gpt-4o-mini

# --- Persistence: PostgreSQL + pgvector ---
# One database holds the payment_rates table, the eCFR embeddings, and the
# LangGraph checkpointer. The pgvector extension must be enabled (init_db does
# CREATE EXTENSION IF NOT EXISTS vector).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nrcs_navigator

# --- Data source URLs (live scrapes; pinned here so they are easy to update) ---
# NRCS Practice Standards index — powers practice_matcher.
NRCS_PRACTICE_STANDARDS_URL=
# NRCS Ranking Dates page — powers program_availability.
NRCS_RANKING_DATES_URL=
