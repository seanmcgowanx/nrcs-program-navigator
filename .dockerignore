# Keep the build context small and free of secrets / unrelated toolchains.
.git
.venv
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Frontend is deployed separately on Vercel; not part of the backend image.
frontend/

# Notebooks and local data are not needed at runtime.
notebooks/
data/raw/

# Never ship secrets.
.env
*.env
!.env.example

# Local plan / scratch files.
.claude/
